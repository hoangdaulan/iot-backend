# Copy to .env for `go run ./cmd/server` (export the variables, e.g. `set -a; . ./.env; set +a`).
HTTP_PORT=8080
DATABASE_URL=postgres://myiot:myiot@localhost:5432/myiot?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h
CORS_ALLOWED_ORIGINS=*
RUN_MIGRATIONS=true
RUN_SEEDS=true

MQTT_ENABLED=true
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=myiot-backend
MQTT_QOS=1
MQTT_TOPIC_SENSOR_DATA=myiot/esp32/sensor-data
MQTT_TOPIC_DEVICE_CONTROL=myiot/esp32/device-control
MQTT_TOPIC_DEVICE_RESPONSE=myiot/esp32/device-response
MQTT_COMMAND_TIMEOUT=5s
